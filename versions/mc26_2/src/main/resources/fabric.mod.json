{
  "schemaVersion": 1,
  "id": "blocklens",
  "version": "${version}",
  "name": "BlockLens",
  "description": "Client-side visual inspection for Minecraft blocks and resources.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.blocklens.fabric.BlockLensClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
